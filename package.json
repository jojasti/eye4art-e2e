{
  "name": "eye4art-e2e",
  "version": "1.0.0",
  "description": "E2E test automation for eye4artstudio.com - Playwright, TypeScript, Cucumber BDD, GitHub Actions",
  "main": "index.js",
  "scripts": {
    "bddgen": "bddgen",
    "test": "bddgen && playwright test",
    "test:headed": "bddgen && playwright test --headed",
    "test:ui": "bddgen && playwright test --ui",
    "report": "playwright show-report",
    "lint": "eslint .",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jojasti/eye4art-e2e.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/jojasti/eye4art-e2e/issues"
  },
  "homepage": "https://github.com/jojasti/eye4art-e2e#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.12.2",
    "eslint": "^10.11.0",
    "eslint-plugin-playwright": "^2.12.0",
    "husky": "^9.1.7",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.9.8",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.70.0"
  }
}
